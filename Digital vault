-- ================================================
-- COMPARISON OPERATORS
-- ================================================
-- Equal To (=)
SELECT * FROM USERENTITY7 WHERE USER_ID = 1;

-- Greater Than (>)
SELECT * FROM NOMINEES7 WHERE USER_ID > 2;

-- Less Than (<)
SELECT * FROM ACTIVITY_LOG7 WHERE LOG_ID < 5;

-- Greater Than or Equal To (>=)
SELECT * FROM DIGITAL_ASSET7 WHERE ASSET_ID >= 3;

-- Less Than or Equal To (<=)
SELECT * FROM ACCESS_REQUESTS7 WHERE REQ_ID <= 4;

-- Not Equal To (<>)
SELECT * FROM USERENTITY7 WHERE USER_ID <> 2;

-- ================================================
-- LOGICAL OPERATORS
-- ================================================
SELECT * FROM USERENTITY7 WHERE USER_ID >= 1 AND PHONE_NO IS NOT NULL;
SELECT * FROM ACTIVITY_LOG7 WHERE ACTION = 'Login' AND STATUS = 'Success';
SELECT * FROM NOMINEES7 WHERE RELATIONSHIP = 'Father' OR RELATIONSHIP = 'Mother';
SELECT * FROM ACCESS_REQUESTS7 WHERE STATUS = 'Pending' OR STATUS = 'Approved';
SELECT * FROM USERENTITY7 WHERE NOT USER_ID = 1;
SELECT * FROM DIGITAL_ASSET7 WHERE NOT ASSET_TYPE = 'Email';

-- ================================================
-- IN / NOT IN / BETWEEN / LIKE / IS NULL
-- ================================================
SELECT * FROM NOMINEES7 WHERE USER_ID NOT IN (4,5);
SELECT * FROM DIGITAL_ASSET7 WHERE ASSET_TYPE NOT IN ('Email','Bank');
SELECT * FROM USERENTITY7 WHERE USER_ID BETWEEN 2 AND 5;
SELECT * FROM ACTIVITY_LOG7 WHERE LOG_ID BETWEEN 1 AND 4;
SELECT * FROM USERENTITY7 WHERE FULL_NAME LIKE 'Sri%';
SELECT * FROM DIGITAL_ASSET7 WHERE ACCOUNT_NAME LIKE '%mail%';
SELECT * FROM USERENTITY7 WHERE PHONE_NO IS NULL;


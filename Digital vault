-- ================================================
-- ORDER BY
-- ================================================
SELECT * FROM USERENTITY7 ORDER BY FULL_NAME;
SELECT * FROM DIGITAL_ASSET7 ORDER BY ASSET_ID DESC;

-- ================================================
-- AGGREGATE FUNCTIONS
-- ================================================
SELECT DISTINCT STATUS FROM ACCESS_REQUESTS7;
SELECT DISTINCT ASSET_TYPE FROM DIGITAL_ASSET7;
SELECT COUNT(*) AS TOTAL_USERS FROM USERENTITY7;
SELECT COUNT(*) AS TOTAL_ASSETS FROM DIGITAL_ASSET7;
SELECT MAX(USER_ID) AS MAX_USER_ID FROM USERENTITY7;
SELECT MAX(ASSET_ID) AS MAX_ASSET_ID FROM DIGITAL_ASSET7;
SELECT MIN(USER_ID) AS MIN_USER_ID FROM USERENTITY7;
SELECT MIN(LOG_ID) AS MIN_LOG_ID FROM ACTIVITY_LOG7;
SELECT AVG(USER_ID) AS AVERAGE_USER_ID FROM USERENTITY7;
SELECT AVG(ASSET_ID) AS AVERAGE_ASSET_ID FROM DIGITAL_ASSET7;
SELECT SUM(USER_ID) AS TOTAL_USER_ID FROM USERENTITY7;
SELECT SUM(ASSET_ID) AS TOTAL_ASSET_ID FROM DIGITAL_ASSET7;


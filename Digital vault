-- ================================================
-- VIEW : USER_DETAILS7
-- ================================================
CREATE OR REPLACE VIEW USER_DETAILS7 AS
SELECT USER_ID,
       FULL_NAME,
       EMAIL
FROM USERENTITY7;

SELECT * FROM USER_DETAILS7;

-- ================================================
-- VIEW : USER_CONTACT7
-- ================================================
CREATE OR REPLACE VIEW USER_CONTACT7 AS
SELECT USER_ID,
       FULL_NAME,
       PHONE_NO
FROM USERENTITY7;

SELECT * FROM USER_CONTACT7;

-- ================================================
-- VIEW : USER_NOMINEE7
-- ================================================
CREATE OR REPLACE VIEW USER_NOMINEE7 AS
SELECT U.USER_ID,
       U.FULL_NAME,
       N.NOMINEE_NAME
FROM USERENTITY7 U
JOIN NOMINEES7 N
ON U.USER_ID = N.USER_ID;

SELECT * FROM USER_NOMINEE7;

